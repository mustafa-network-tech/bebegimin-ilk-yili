NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Yeni Supabase projeleri için önerilen public anahtar:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# Eski projelerde yukarıdaki yerine bu değişken kullanılabilir:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000

# Server-only Google Play Developer API. Never prefix these with NEXT_PUBLIC_.
GOOGLE_PLAY_PACKAGE_NAME=com.mkdigitalsystems.bebegimin_ilk_yili
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=PASTE_THE_COMPLETE_SERVICE_ACCOUNT_JSON_HERE
