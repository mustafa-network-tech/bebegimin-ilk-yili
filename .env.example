# ---------------------------------------------------------------------------
# Bebeğimin İlk Yılı — environment variables (TEMPLATE, never commit real values)
# ---------------------------------------------------------------------------
# Flutter reads build-time values from env/<name>.json:
#   cp env/example.json env/dev.json   # then edit
#   flutter run --dart-define-from-file=env/dev.json
#
# ---- Mobile app (public values only!) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# anon / publishable key. NEVER put the service_role key into the app.
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
AUTH_REDIRECT_URL=bebegimin://login-callback
INVITE_LINK_BASE=bebegimin://invite
MAX_VIDEO_MB=200
# Shows demo-account shortcuts on the login screen (local seed data only).
DEMO_MODE=false
# Opens the legacy on-device book tools for LOCKED profiles (internal testing only).
PREMIUM_PREVIEW=false

# Optional push notifications (Firebase Cloud Messaging) – leave empty to disable.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=

# ---- Supabase Edge Function secrets (server side only) ----
# supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are injected
# automatically by Supabase in hosted Edge Functions.
PUSH_WEBHOOK_SECRET=generate-a-long-random-string
STORAGE_CLEANUP_SECRET=generate-another-long-random-string
# Mock payment provider (until a store / payment provider is chosen).
BILLING_MOCK_SECRET=generate-a-third-long-random-string
# App Store (in-app subscriptions)
APPLE_BUNDLE_ID=app.bebegimin.bebegiminIlkYili
APPLE_APP_APPLE_ID=
APPLE_ENVIRONMENT=Sandbox
# Comma separated base64 DER of Apple Root CA - G3 (https://www.apple.com/certificateauthority/)
APPLE_ROOT_CERTS_B64=
# App Store Server API key (optional, recommended): App Store Connect > Users and Access > Integrations
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Google Play (in-app subscriptions)
GOOGLE_PLAY_PACKAGE_NAME=app.bebegimin.bebegimin_ilk_yili
# Service account JSON with access to orders/subscriptions in Play Console
GOOGLE_PLAY_SERVICE_ACCOUNT=
# Secret in the Pub/Sub push endpoint URL for Real-time Developer Notifications
GOOGLE_RTDN_TOKEN=generate-a-fourth-long-random-string
# Full JSON of a Firebase service account with the "Firebase Cloud Messaging API" role.
FCM_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Output worker (workers/output: film ADR 0004, offline archive ADR 0005) -
# runs in its own container, NOT in Supabase. Never ship the service role
# key to the app.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# WORKER_PRODUCTS=first_year_film,first_year_html
# WORKER_ID=output-1
# POLL_INTERVAL_MS=15000
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# FONT_DIR=/app/fonts
# WORK_DIR=/tmp/film
